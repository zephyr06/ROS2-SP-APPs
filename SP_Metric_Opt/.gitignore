# Python caching
*pycache*
*.py[cod]
*$py.class
.pytest_cache/

# Taskset generation example & test outputs
Gen_Taskset/examples/output_example/*
Gen_Taskset/tests/test_output/

# CMake / C++ build outputs
build/
release/
build_test/
bin/
/lib/
obj/

# Simulation Experiment Outputs & Configs
!TaskData/AnalyzeSP_Metric/*
TaskData/*/
TaskData/*.txt
TaskData/*.json
# Unit-test fixtures must be tracked (test_real_world_robot_config scenarios).
# Negations MUST come after TaskData/*/ (git is last-match-wins) and re-include
# the directory itself so git descends into it.
!TaskData/test_real_world_robot_config/
!TaskData/test_real_world_robot_config/**
temp_experiment_configs/
temp_experiment_configs_*/
temp/
Gen_Taskset/simulation_tasksets/
tests/comparison_runs/*
tests/test_output*
tests/e2e_eval*
tests/test_cfs_debug*
tests/*analysis*
!tests/debug_analysis/
!tests/debug_analysis/**
tests/k_variation/*
tests/radius_comparison/*
test_taskset_*gen*/*
simulation_experiments/optimizer_comparison/
simulation_experiments/debug_analysis/

# Benchmarking, diagnostics, and scratch evaluation harness
# (bench drivers, p24-eval sweep scripts, run logs/pid files). Local-only.
/benchmark/
/Testing/
temp_run/

# P0.8 important-task diagnostic output (generated JSON run results, NOT source).
# The harness scripts themselves (measure_*.py) ARE tracked — only their output is ignored.
simulation_experiments/important_utilization/
simulation_experiments/important_task_gate_rejection/
# Scratch test fixture emitted by ad-hoc RTA I/O checks (not a paper fixture).
TaskData/test_io_important.yaml
# Editor / autosave backups of the local parameters.yaml (build-managed, not source).
sources/.parameters.yaml.*.bak

# Binary / Output / Log formats
*.log
*.pdf
*.png
*.csv
*.pyc

# Paper simulation figures (new refresh set): track despite *.pdf ignore above
!paper_sections/full_paper_sections/pictures/simulation/simulation_scale/*.pdf
!paper_sections/full_paper_sections/pictures/simulation/simulation_bf/*.pdf

agents/gemini.md
agents/kimi.md
agents/dev_log.md

# LaTeX build artifacts (paths are relative to this .gitignore's dir,
# i.e. SP_Metric_Opt/ — do NOT prefix with SP_Metric_Opt/ or they double).
*paper_sections/full_paper_sections/main.aux
*paper_sections/full_paper_sections/main.bbl
*paper_sections/full_paper_sections/main.blg
*paper_sections/full_paper_sections/main.fdb_latexmk
*paper_sections/full_paper_sections/main.fls
*paper_sections/full_paper_sections/main.fts
*paper_sections/full_paper_sections/main.log
*paper_sections/full_paper_sections/main.out
*paper_sections/full_paper_sections/main.synctex.gz